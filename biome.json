{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": false
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "es5",
      "lineEnding": "lf"
    },
    "globals": ["React"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off",
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input", "Textarea"]
          }
        }
      },
      "style": {
        "preset": "recommended",
        "noDefaultExport": "error",
        "noImplicitBoolean": "off",
        "useComponentExportOnlyModules": {
          "level": "warn",
          "options": {
            "allowExportNames": [
              "metadata",
              "generateMetadata",
              "generateStaticParams",
              "viewport",
              "generateViewport",
              "dynamicParams",
              "dynamic",
              "revalidate",
              "alt",
              "size",
              "contentType"
            ]
          }
        }
      },
      "suspicious": {
        "noReactSpecificProps": "off",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      },
      "correctness": {
        "useImportExtensions": "off",
        "noReactNativeRawText": "off",
        "noProcessGlobal": "off",
        "noNodejsModules": "off",
        "useJsonImportAttributes": "off"
      },
      "preset": "all",
      "performance": {
        "noJsxPropsBind": "off"
      },
      "complexity": {
        "noExcessiveLinesPerFunction": "off"
      }
    },
    "domains": {
      "react": "all",
      "next": "all",
      "solid": "none",
      "qwik": "none",
      "vue": "none"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!.claude",
      "!.impeccable",
      "!**/*.md"
    ]
  },
  "overrides": [
    {
      "includes": [
        "**/src/app/**/page.tsx",
        "**/src/app/**/layout.tsx",
        "**/src/app/**/not-found.tsx",
        "**/*.config.js",
        "**/*.config.mjs",
        "**/*.config.ts",
        "**/src/app/sitemap.ts",
        "**/src/app/robots.ts",
        "**/src/i18n/request.ts",
        "**/src/proxy.ts",
        "**/src/app/global-not-found.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/@types/**/*.d.ts",
        "**/src/components/icons/**/*.tsx",
        "**/src/app/**/layout.tsx",
        "**/src/components/navbar.tsx",
        "**/src/components/footer.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off",
            "useUniqueElementIds": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/components/icons/**/*.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noReExportAll": "off",
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/app/**/sections/*.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "useUniqueElementIds": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/data/site.ts"],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": "off"
          }
        }
      }
    }
  ]
}
